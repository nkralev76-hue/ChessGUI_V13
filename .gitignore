# Build artifacts / binaries (ignored by default)
*.exe
*.dll
# Portable distribution — tracked for all machines
!Ferz_v13_dist/*.exe
!Ferz_v13_dist/*.dll
!Ferz_v13_dist/**/*.png

# Logs
*.log

# Code-signing certificate (contains sensitive key material - do NOT commit)
codesign_cert.pem

# OS / editor cruft
Thumbs.db
Desktop.ini
